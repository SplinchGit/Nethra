[Unit]
Description=Persistent Nethra World cognition runtime
After=nethra-world.service
Requires=nethra-world.service
StartLimitIntervalSec=300s
StartLimitBurst=5

[Service]
Type=simple
User=nethra
Group=nethra
WorkingDirectory=/home/nethra/nethra
Environment=HOME=/home/nethra
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -I -B /usr/lib/nethra-world/agent.py
KillMode=control-group
KillSignal=SIGTERM
TimeoutStopSec=40
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/nethra/nethra
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=768M
CPUQuota=80%
TasksMax=64
LimitFSIZE=33554432
LimitNOFILE=128
LimitNPROC=64
StandardOutput=journal
StandardError=journal
